# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, choose one provider, and replace its placeholder key.

# Google AI Studio / Gemini (free-tier availability depends on your account).
AI_PROVIDER=gemini
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI alternative:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
